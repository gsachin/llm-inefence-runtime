{
  "openapi": "3.0.0",
  "info": {
    "title": "LLM Inference Runtime API",
    "description": "OpenAI-compatible LLM inference API powered by vLLM and KServe",
    "version": "1.0.0",
    "contact": {
      "name": "Inference Runtime Team"
    },
    "license": {
      "name": "Apache 2.0"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development (via kubectl port-forward)"
    },
    {
      "url": "http://my-llm-predictor:80",
      "description": "In-cluster service"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check endpoint",
        "description": "Returns 200 OK if the service is ready",
        "operationId": "health_check",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "ok"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "summary": "List available models",
        "description": "Returns a list of currently loaded models",
        "operationId": "list_models",
        "tags": ["Models"],
        "responses": {
          "200": {
            "description": "List of available models",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "example": "list"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "Qwen/Qwen2.5-0.5B-Instruct"
                          },
                          "object": {
                            "type": "string",
                            "example": "model"
                          },
                          "created": {
                            "type": "integer",
                            "example": 1704096000
                          },
                          "owned_by": {
                            "type": "string",
                            "example": "vllm"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Create a chat completion",
        "description": "Generates a completion for a chat conversation (OpenAI-compatible).\nSimilar to OpenAI's chat.completions endpoint.",
        "operationId": "create_chat_completion",
        "tags": ["Chat"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "example": {
                "model": "Qwen/Qwen2.5-0.5B-Instruct",
                "messages": [
                  {
                    "role": "user",
                    "content": "What is 2+2?"
                  }
                ],
                "max_tokens": 20,
                "temperature": 0.7
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid parameters)"
          },
          "404": {
            "description": "Model not found"
          },
          "503": {
            "description": "Service overloaded"
          }
        }
      }
    },
    "/v1/completions": {
      "post": {
        "summary": "Create a text completion",
        "description": "Generates a completion for a given text prompt.\nSimilar to OpenAI's text-completion endpoint.",
        "operationId": "create_completion",
        "tags": ["Completions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionRequest"
              },
              "example": {
                "model": "Qwen/Qwen2.5-0.5B-Instruct",
                "prompt": "The capital of France is",
                "max_tokens": 10
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Text completion response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "503": {
            "description": "Service overloaded"
          }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "summary": "Create embeddings",
        "description": "Creates vector embeddings for input text",
        "operationId": "create_embeddings",
        "tags": ["Embeddings"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmbeddingRequest"
              },
              "example": {
                "model": "Qwen/Qwen2.5-0.5B-Instruct",
                "input": "Hello, world!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Embeddings response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "503": {
            "description": "Service overloaded"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics",
        "description": "Returns service metrics in Prometheus format",
        "operationId": "get_metrics",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Prometheus metrics",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": ["model", "messages"],
        "properties": {
          "model": {
            "type": "string",
            "description": "Model ID to use for completion",
            "example": "Qwen/Qwen2.5-0.5B-Instruct"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "description": "List of messages in the conversation"
          },
          "max_tokens": {
            "type": "integer",
            "description": "Maximum number of tokens to generate",
            "minimum": 1,
            "example": 50
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature (0.0 to 2.0)",
            "minimum": 0.0,
            "maximum": 2.0,
            "default": 0.7,
            "example": 0.7
          },
          "top_p": {
            "type": "number",
            "description": "Nucleus sampling probability (0.0 to 1.0)",
            "minimum": 0.0,
            "maximum": 1.0,
            "default": 0.8
          },
          "top_k": {
            "type": "integer",
            "description": "Top-K sampling",
            "default": 20
          },
          "repetition_penalty": {
            "type": "number",
            "description": "Penalty for repeating tokens",
            "default": 1.1
          },
          "stop": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Stop sequences",
            "example": ["\\n"]
          },
          "stream": {
            "type": "boolean",
            "description": "Stream partial message deltas",
            "default": false
          },
          "presence_penalty": {
            "type": "number",
            "description": "Presence penalty",
            "default": 0.0
          },
          "frequency_penalty": {
            "type": "number",
            "description": "Frequency penalty",
            "default": 0.0
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"],
            "description": "Role of the message sender"
          },
          "content": {
            "type": "string",
            "description": "Message content",
            "example": "What is 2+2?"
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique completion ID",
            "example": "chatcmpl-abc123"
          },
          "object": {
            "type": "string",
            "example": "text_completion"
          },
          "created": {
            "type": "integer",
            "description": "Unix timestamp",
            "example": 1704096000
          },
          "model": {
            "type": "string",
            "example": "Qwen/Qwen2.5-0.5B-Instruct"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "example": "assistant"
                    },
                    "content": {
                      "type": "string",
                      "example": "4"
                    }
                  }
                },
                "finish_reason": {
                  "type": "string",
                  "enum": ["stop", "length"]
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer",
                "example": 20
              },
              "completion_tokens": {
                "type": "integer",
                "example": 2
              },
              "total_tokens": {
                "type": "integer",
                "example": 22
              }
            }
          }
        }
      },
      "CompletionRequest": {
        "type": "object",
        "required": ["model", "prompt"],
        "properties": {
          "model": {
            "type": "string",
            "example": "Qwen/Qwen2.5-0.5B-Instruct"
          },
          "prompt": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Prompt text or array of prompts",
            "example": "The capital of France is"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "example": 10
          },
          "temperature": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 2.0,
            "default": 0.7
          },
          "top_p": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "default": 0.8
          },
          "top_k": {
            "type": "integer",
            "default": 20
          },
          "repetition_penalty": {
            "type": "number",
            "default": 1.1
          },
          "stop": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["\\n"]
          }
        }
      },
      "CompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cmpl-abc123"
          },
          "object": {
            "type": "string",
            "example": "text_completion"
          },
          "created": {
            "type": "integer",
            "example": 1704096000
          },
          "model": {
            "type": "string",
            "example": "Qwen/Qwen2.5-0.5B-Instruct"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "example": "Paris"
                },
                "index": {
                  "type": "integer"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": ["stop", "length"]
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer"
              },
              "completion_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              }
            }
          }
        }
      },
      "EmbeddingRequest": {
        "type": "object",
        "required": ["model", "input"],
        "properties": {
          "model": {
            "type": "string",
            "example": "Qwen/Qwen2.5-0.5B-Instruct"
          },
          "input": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Input text or array of texts",
            "example": "Hello, world!"
          }
        }
      },
      "EmbeddingResponse": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "example": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object": {
                  "type": "string",
                  "example": "embedding"
                },
                "embedding": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "Vector embedding"
                },
                "index": {
                  "type": "integer"
                }
              }
            }
          },
          "model": {
            "type": "string"
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": {
                "type": "integer"
              },
              "total_tokens": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "System",
      "description": "Health and system endpoints"
    },
    {
      "name": "Models",
      "description": "Model management"
    },
    {
      "name": "Chat",
      "description": "Chat completion endpoints"
    },
    {
      "name": "Completions",
      "description": "Text completion endpoints"
    },
    {
      "name": "Embeddings",
      "description": "Embedding endpoints"
    }
  ]
}
